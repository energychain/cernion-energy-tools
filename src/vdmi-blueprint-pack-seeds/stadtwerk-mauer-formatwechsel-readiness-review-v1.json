    "note": "Any later operational verification stays behind a separately curated operations-runbook wrapper; this seed never calls Rundeck directly."
  },
  "demoTenant": {
    "tenantId": "stadtwerk-mauer",
    "classification": "synthetic_demo_tenant",
    "description": "Virtual Stadtwerk Mauer demo tenant; system, patch, format, process, Fachtest, owner, deadline and evidence references for this format-change readiness review are invented."
  },
  "roleQuestion": {
    "actor": "Marktkommunikation / IT Operations / Cernion Governance",
    "answerableIn": "under_one_minute",
    "question": "Sind System-/Patch-/Formatumfang, Fachtest und Prozesskette, Stop-/Rollback-Evidenz sowie Owner/Frist fuer ein menschliches Go-live-Review vollstaendig - oder welche Evidenz und welches sichere Review-Gate fehlen?"
  },
  "dataClasses": {
    "publicContextLayer": {
      "description": "Optional read-only public regulatory or format-context hints; not mutable and not removable by reset/delete.",
      "examples": ["public format-version advisory", "read-only regulatory changelog reference", "non-binding governance vocabulary"]
    },
    "syntheticTenantSeed": {
      "description": "Invented Stadtwerk-Mauer system, patch, format, process, Fachtest, owner, deadline and evidence references for this readiness review.",
      "examples": ["synthetic system landscape entry", "synthetic patch level marker", "synthetic Fachtest case reference"]
    },
    "sandboxRuntimeArtifact": {
      "description": "Resettable validator/render/smoke proof from Cernion or Workbench verification runs, separate from public context baselines.",
      "examples": ["matrix-sync render artifact", "read-model refresh proof", "smoke validation proof"]
    }
  },
  "roles": [
    {
      "roleId": "ROLE_MARKTKOMMUNIKATION",
      "relation": "verantwortlich",
      "responsibility": "Owns the review-readiness decision boundary for the format-change readiness review; surfaces missing evidence without granting format or Go-live approval."
    },
    {
      "roleId": "ROLE_IT_OPERATIONS",
      "relation": "durchfuehrend",
      "responsibility": "Provides system/patch/format scope and affected-process-chain/Fachtest evidence without SAP/ERP writes, EDIFACT retries or format conversion."
    },
    {
      "roleId": "ROLE_CERNION_GOVERNANCE",
      "relation": "durchfuehrend",
      "responsibility": "Verifies operational-safety and decision-readiness evidence, the Blueprint-Pack seed, matrix sync and no-call boundary without creating runtime records."
    },
    {
      "roleId": "ROLE_PROCESS_OWNER",
      "relation": "mitwirkend",
      "responsibility": "Provides scope-boundary context for the affected process family without approving the format change."
    },
    {
      "roleId": "ROLE_BILLING_GOVERNANCE",
      "relation": "mitwirkend",
      "responsibility": "Provides Fachtest, validation and decision-readiness context without executing billing, settlement or tariff mutation."
    },
    {
      "roleId": "ROLE_MANAGEMENT_REVIEW",
      "relation": "information",
      "responsibility": "Receives review-readiness status and missing-evidence context without approving Go-live, format conversion or a MaKo/SAP/Billing action."
    }
  ],
  "evidenceRequirements": [
    {
      "id": "systemLandscapeEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "clarification",
      "enablesDossierAddition": "Adds the synthetic system landscape row so the reviewed format scope can be located within the tenant's system inventory."
    },
    {
      "id": "patchLevelEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "clarification",
      "enablesDossierAddition": "Adds the synthetic patch level so the review can confirm which patch introduces the format change."
    },
    {
      "id": "formatVersionEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "clarification",
      "enablesDossierAddition": "Adds the synthetic format version pairing so the review can confirm old-to-new format scope."
    },
    {
      "id": "scopeBoundaryEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "clarification",
      "enablesDossierAddition": "Adds the scope-boundary note so the review can confirm what is explicitly out of scope for this format change."
    },
    {
      "id": "affectedProcessChainEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "evidence_gap",
      "enablesDossierAddition": "Adds the affected market-communication process chain so the review can see downstream impact before Fachtest."
    },
    {
      "id": "fachtestCaseEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "evidence_gap",
      "enablesDossierAddition": "Adds the synthetic Fachtest case reference proving the format change was exercised in a test lane."
    },
    {
      "id": "validationResultEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "evidence_gap",
      "enablesDossierAddition": "Adds the Fachtest validation result so the review can see pass/fail status without re-running the test."
    },
    {
      "id": "sourceSnapshotEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "evidence_gap",
      "enablesDossierAddition": "Adds the source snapshot reference used for the Fachtest so the review can trace which data was exercised."
    },
    {
      "id": "automationRiskEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "evidence_gap",
      "enablesDossierAddition": "Adds the automation-risk classification so the review can see whether downstream automation is affected."
    },
    {
      "id": "monitoringEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "evidence_gap",
      "enablesDossierAddition": "Adds the monitoring-coverage note so the review can confirm the format change is observable after cutover."
    },
    {
      "id": "stopCriterionEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "evidence_gap",
      "enablesDossierAddition": "Adds the stop-criterion definition so the review can see what safely halts the format change."
    },
    {
      "id": "rollbackEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "evidence_gap",
      "enablesDossierAddition": "Adds the rollback-path note so the review can confirm a safe reversal exists before Go-live."
    },
    {
      "id": "ownerDeadlineEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "evidence_gap",
      "enablesDossierAddition": "Adds the accountable owner and deadline so operational-safety accountability is visible without creating a workflow or HITL task."
    },
    {
      "id": "decisionReadinessEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "clarification",
      "enablesDossierAddition": "Adds the decision-readiness marker so the review can see whether the case is ready for a human Go-live review."
    },
    {
      "id": "positiveFollowUpEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "clarification",
      "enablesDossierAddition": "Adds the remaining evidence gaps as positive Workbench additions for the next human review."
    },
    {
      "id": "nextHumanGateEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "clarification",
      "enablesDossierAddition": "Adds the next safe human review gate without granting Go-live, format or MaKo/SAP/Billing approval."
    },
    {
      "id": "noCallGuardEvidence",
      "required": true,
      "dataClass": "syntheticTenantSeed",
      "missingState": "clarification",
      "enablesDossierAddition": "Adds confirmation that no dashboard source hint, connector or Rundeck call was executed while assembling this review."
    }
  ],
