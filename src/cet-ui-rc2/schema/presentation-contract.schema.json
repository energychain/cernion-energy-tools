{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cernion.de/schemas/cet-ui-rc2/presentation-contract.schema.json",
  "title": "CET UI RC2 Presentation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "form",
    "titel",
    "stand",
    "aussagen",
    "befunde",
    "handlungen",
    "nichtHandlungen"
  ],
  "properties": {
    "schemaVersion": { "type": "string", "const": "rc2.presentation-contract.v1" },
    "form": {
      "type": "string",
      "enum": ["gate", "befundliste", "zeitreihe", "mengengeruest", "vergleich", "text"]
    },
    "titel": { "type": "string", "minLength": 1 },
    "stand": { "type": "string", "minLength": 1 },
    "aussagen": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/aussage" }
    },
    "befunde": {
      "type": "array",
      "items": { "$ref": "#/$defs/befund" }
    },
    "handlungen": {
      "type": "array",
      "items": { "$ref": "#/$defs/handlung" }
    },
    "nichtHandlungen": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/nichtHandlung" }
    },
    "freigabe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["erforderlich"],
      "properties": {
        "erforderlich": { "type": "boolean" },
        "rolle": { "type": "string" },
        "status": {
          "type": "string",
          "enum": [
            "nicht_erforderlich",
            "erforderlich",
            "angefordert",
            "erteilt",
            "verweigert",
            "offen"
          ]
        },
        "akteur": { "type": "string" }
      }
    }
  },
  "$defs": {
    "aussage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "quelle", "sicherheit", "aggregatzustand", "granularitaet"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "wert": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "einheit": { "type": "string" },
        "aggregatzustand": {
          "type": "string",
          "enum": ["arbeitsstand", "nachweisakte", "entscheidungsreif", "gesicherter_stand"]
        },
        "granularitaet": { "type": "string", "enum": ["aggregat", "einzeldatensatz"] },
        "materialisierung": { "type": "string", "enum": ["materialisiert", "hash_ref_only"] },
        "hashRef": { "$ref": "#/$defs/hashRef" },
        "reproduzierbarkeit": {
          "type": "string",
          "enum": ["vollstaendig", "nur_mit_quelle_reproduzierbar"]
        },
        "quelle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["klasse", "ref", "stand"],
          "properties": {
            "klasse": {
              "type": "string",
              "enum": ["system_of_record", "caller_supplied", "abgeleitet", "extern"]
            },
            "ref": { "type": "string", "minLength": 1 },
            "stand": { "type": "string", "minLength": 1 }
          }
        },
        "sicherheit": { "type": "string", "enum": ["belegt", "klaerung", "ungeprueft"] },
        "anschlussfrage": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "sicherheit": { "const": "klaerung" } },
            "required": ["sicherheit"]
          },
          "then": {
            "properties": { "anschlussfrage": { "type": "string", "minLength": 1 } },
            "required": ["anschlussfrage"]
          }
        },
        {
          "if": {
            "properties": { "granularitaet": { "const": "einzeldatensatz" } },
            "required": ["granularitaet"]
          },
          "then": {
            "required": ["materialisierung", "hashRef", "reproduzierbarkeit"],
            "properties": {
              "materialisierung": { "const": "hash_ref_only" },
              "hashRef": { "$ref": "#/$defs/hashRef" },
              "reproduzierbarkeit": { "const": "nur_mit_quelle_reproduzierbar" }
            },
            "not": {
              "properties": {
                "wert": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "boolean" },
                    { "type": "null" }
                  ]
                }
              },
              "required": ["wert"]
            }
          }
        }
      ]
    },
    "hashRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithmus", "wert"],
      "properties": {
        "algorithmus": { "type": "string", "const": "sha256" },
        "wert": { "type": "string", "minLength": 1 }
      }
    },
    "befund": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "quelle", "sicherheit", "granularitaet"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "wert": {
          "anyOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "null" }
          ]
        },
        "einheit": { "type": "string" },
        "granularitaet": { "type": "string", "enum": ["aggregat", "einzeldatensatz"] },
        "materialisierung": { "type": "string", "enum": ["materialisiert", "hash_ref_only"] },
        "hashRef": { "$ref": "#/$defs/hashRef" },
        "quelle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["klasse", "ref", "stand"],
          "properties": {
            "klasse": {
              "type": "string",
              "enum": ["system_of_record", "caller_supplied", "abgeleitet", "extern"]
            },
            "ref": { "type": "string", "minLength": 1 },
            "stand": { "type": "string", "minLength": 1 }
          }
        },
        "sicherheit": { "type": "string", "enum": ["belegt", "klaerung", "ungeprueft"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "granularitaet": { "const": "einzeldatensatz" } },
            "required": ["granularitaet"]
          },
          "then": {
            "required": ["materialisierung", "hashRef"],
            "properties": {
              "materialisierung": { "const": "hash_ref_only" },
              "hashRef": { "$ref": "#/$defs/hashRef" }
            },
            "not": {
              "properties": {
                "wert": {
                  "anyOf": [
                    { "type": "string" },
                    { "type": "number" },
                    { "type": "boolean" },
                    { "type": "null" }
                  ]
                }
              },
              "required": ["wert"]
            }
          }
        }
      ]
    },
    "handlung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "riskClass", "erlaubtFuerRolle"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "riskClass": { "type": "string", "minLength": 1 },
        "erlaubtFuerRolle": { "type": "boolean" }
      }
    },
    "nichtHandlung": {
      "type": "object",
      "additionalProperties": false,
      "required": ["was", "grund"],
      "properties": {
        "was": { "type": "string", "minLength": 1 },
        "grund": { "type": "string", "minLength": 1 }
      }
    }
  }
}
