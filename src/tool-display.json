{
  "energy-market.installations": {
    "source": "MaStR",
    "fields": {
      "installationType": {
        "values": {
          "solar": "Solar",
          "wind": "Wind",
          "storage": "Speicher"
        }
      },
      "operationalStatus": {
        "values": {
          "all": "alle Betriebszustände"
        },
        "lookup": {
