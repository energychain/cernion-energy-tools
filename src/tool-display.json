          "field": "einheitBetriebsstatus"
        }
      },
      "minCapacityKW": {
        "prefix": "> ",
        "suffix": " kW"
      },
      "maxCapacityKW": {
        "prefix": "< ",
        "suffix": " kW"
      },
      "location": {},
      "city": {},
      "postalCode": {},
      "gridOperatorName": {},
      "postleitzahl": {
        "prefix": "PLZ "
      },
      "commissioningYear": {
        "prefix": "Inbetriebnahme "
      }
    },
    "resultFields": {
      "einheitBetriebsstatus": "operationalStatus",
      "EinheitBetriebsstatus": "operationalStatus"
    },
    "defaults": {
      "operationalStatus": "35"
    }
  }
