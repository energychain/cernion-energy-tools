{
  "name": "cernion-energy-tools",
  "version": "0.66.3",
  "description": "MicroService Agent System for Energy Markets",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "moleculer-runner --repl --hot services custom-services",
    "cli": "node cli.js",
    "create": "node create-service.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:hygiene": "ESLINT_USE_FLAT_CONFIG=false eslint services/ src/ --config .eslintrc.hygiene.json --format unix --no-eslintrc 2>/dev/null > feedback/eslint-findings.txt && wc -l feedback/eslint-findings.txt",
    "format": "prettier --write \"**/*.js\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --testPathIgnorePatterns=\"tests/.*\\.integration\\.test\\.js|custom-tests\"",
    "test:unit:ci": "NODE_OPTIONS=--experimental-vm-modules jest --coverage --runInBand --forceExit --testPathIgnorePatterns=\"tests/.*\\.integration\\.test\\.js|custom-tests\"",
    "test:e2e": "jest --no-coverage tests/assets.integration.test.js",
    "test:e2e:enterprise": "jest tests/e2e-enterprise-hoeheinoed.test.js --runInBand --forceExit",
    "test:custom": "jest --coverage=false --testPathPatterns=custom-tests",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --coverage=false --testMatch=\"**/tests/**/*.integration.test.js\"",
    "test:live": "jest --no-coverage tests/assets.integration.test.js",
    "test:rest-usecases": "NODE_OPTIONS=--experimental-vm-modules jest --coverage=false --runInBand tests/rest-usecases",
    "test:tdd-matrix": "NODE_OPTIONS=--experimental-vm-modules jest --coverage=false --runInBand tests/personal-agent-tdd-matrix-parser.test.js tests/personal-agent-tdd-matrix-normalizer.test.js tests/personal-agent-tdd-matrix.generated.test.js tests/personal-agent-tdd-matrix-multiturn.generated.test.js",
    "check:tdd-matrix-coverage": "node scripts/check-tdd-matrix-coverage.js",
    "audit:openapi": "node scripts/audit-openapi.js",
    "audit:security": "node scripts/audit-security.js",
    "audit:security:advisory": "npm audit --audit-level=high",
    "generate:llm": "node scripts/generate-llm-txt.js",
    "check:llm": "node scripts/generate-llm-txt.js --check",
    "check:quality-gate": "node scripts/check-quality-gate.js",
    "release:check": "npm run test:unit:ci && npm run test:tdd-matrix && npm run check:tdd-matrix-coverage && npm run audit:openapi && npm run check:llm && npm run check:quality-gate && npm run audit:security",
    "export:openapi": "node scripts/export-openapi.js",
    "export:openapi:copilot": "node scripts/export-openapi.js --copilot",
    "sync:oeo": "node scripts/sync-oeo.js",
    "sync:oemetadata": "node scripts/sync-oemetadata.js",
    "migrate:jobs": "node scripts/migrate-jobs.js",
    "seed:rcs-demo": "node scripts/seed-rcs-demo-tenant.js",
    "tenant:create": "node scripts/provision-tenant.js",
    "user:create": "node scripts/provision-user.js",
    "token:create": "node scripts/provision-token.js",
    "verify:agent-shapes": "node scripts/verify-agent-shapes.js",
    "verify:agent-shapes:curl": "bash scripts/verify-agent-shapes-curl.sh",
    "build": "echo 'No build step required'",
    "blueprint:export": "node scripts/export-blueprints.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/energychain/cernion-energy-tools.git"
  },
  "keywords": [
    "energy",
    "microservices",
    "moleculer",
    "mcp",
    "ai",
    "gemini"
  ],
  "author": "Energy Chain",
  "license": "GPL-3.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/energychain/cernion-energy-tools/issues"
  },
  "homepage": "https://github.com/energychain/cernion-energy-tools#readme",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@turf/boolean-point-in-polygon": "^7.3.5",
    "@turf/helpers": "^7.3.4",
    "ajv": "^8.20.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "graphology": "^0.26.0",
    "iconv-lite": "^0.7.2",
    "moleculer": "^0.15.0",
    "moleculer-auto-openapi": "^1.1.7",
    "moleculer-repl": "^0.8.0",
    "moleculer-web": "^0.11.0",
    "nodemailer": "^8.0.7",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.18.0",
    "pino": "^10.1.0",
    "pouchdb": "^9.0.0",
    "pouchdb-find": "^9.0.0",
    "prom-client": "^15.1.3",
    "swagger-ui-dist": "^5.32.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@zazuko/env-node": "^3.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "jest": "^30.4.2",
    "n3": "^2.0.3",
    "prettier": "^3.8.3",
    "rdf-validate-shacl": "^0.6.5"
  }
}
