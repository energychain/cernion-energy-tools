{
  "name": "cernion-energy-tools",
  "version": "0.9.3",
  "description": "MicroService Agent System for Energy Markets",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "moleculer-runner --repl --hot services custom-services",
    "cli": "node cli.js",
    "create": "node create-service.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.js\"",
    "test": "jest --coverage",
    "test:unit": "jest --coverage --testPathIgnorePatterns=\"tests/.*\\.integration\\.test\\.js|custom-tests\"",
    "test:unit:ci": "jest --coverage --runInBand --forceExit --testPathIgnorePatterns=\"tests/.*\\.integration\\.test\\.js|custom-tests\"",
    "test:e2e": "jest --no-coverage tests/assets.integration.test.js",
    "test:custom": "jest --coverage=false --testPathPattern=custom-tests",
    "test:watch": "jest --watch",
    "test:integration": "jest --coverage=false --testMatch=\"**/tests/**/*.integration.test.js\"",
    "test:live": "jest --no-coverage tests/assets.integration.test.js",
    "audit:openapi": "node scripts/audit-openapi.js",
    "audit:security": "node scripts/audit-security.js",
    "audit:security:advisory": "npm audit --audit-level=high",
    "release:check": "npm run test:unit:ci && npm run audit:openapi && npm run audit:security"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/energychain/cernion-energy-tools.git"
  },
  "keywords": [
    "energy",
    "microservices",
    "moleculer",
    "mcp",
    "ai",
    "gemini"
  ],
  "author": "Energy Chain",
  "license": "GPL-3.0",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/energychain/cernion-energy-tools/issues"
  },
  "homepage": "https://github.com/energychain/cernion-energy-tools#readme",
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "axios": "^1.13.4",
    "dotenv": "^17.2.4",
    "iconv-lite": "^0.7.2",
    "moleculer": "^0.14.35",
    "moleculer-auto-openapi": "^1.1.7",
    "moleculer-repl": "^0.7.4",
    "moleculer-web": "^0.10.8",
    "swagger-ui-dist": "^5.11.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jest": "^30.3.0",
    "prettier": "^3.8.1"
  }
}
