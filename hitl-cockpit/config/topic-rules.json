  "terminalStates": ["done", "completed", "archived", "cancelled", "rejected"],
  "statePriority": [
    "blocked",
    "running",
    "ready",
    "todo",
    "triage",
    "scheduled",
    "done",
    "completed",
    "archived",
    "cancelled"
  ]
}
