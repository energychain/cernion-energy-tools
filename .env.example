# Cernion Energy Tools - Environment Configuration

# Moleculer Configuration
NAMESPACE=cernion
NODE_ID=
LOG_LEVEL=info

# API Gateway
PORT=3000
API_URL=http://localhost:3000/api

# Transporter (leave empty for local development, or use NATS, Redis, MQTT, etc.)
# TRANSPORTER=nats://localhost:4222
TRANSPORTER=

# Cacher (leave empty for no caching, or use Memory, Redis, etc.)
# CACHER=Memory
CACHER=

# Google Gemini AI
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=

# Model Context Protocol (MCP)
# Configure MCP server settings if needed
MCP_SERVER_URL=

# Additional service-specific configuration
# Add your service configuration variables here
