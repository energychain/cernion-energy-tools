# Cernion Energy Tools - Environment Configuration

# Moleculer Configuration
NAMESPACE=cernion
NODE_ID=
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=900000

# Reliability toggles (production hardening)
RETRY_POLICY_ENABLED=false
RETRY_POLICY_RETRIES=5
RETRY_POLICY_DELAY_MS=100
RETRY_POLICY_MAX_DELAY_MS=1000
RETRY_POLICY_FACTOR=2

CIRCUIT_BREAKER_ENABLED=false
CIRCUIT_BREAKER_THRESHOLD=0.5
CIRCUIT_BREAKER_MIN_REQUEST_COUNT=20
CIRCUIT_BREAKER_WINDOW_TIME_SEC=60
CIRCUIT_BREAKER_HALF_OPEN_MS=10000

BULKHEAD_ENABLED=false
BULKHEAD_CONCURRENCY=10
BULKHEAD_MAX_QUEUE_SIZE=100

TRACKING_ENABLED=false
TRACKING_SHUTDOWN_TIMEOUT_MS=5000
METRICS_ENABLED=false
TRACING_ENABLED=false

# Async job poller logging (keep disabled in production unless debugging)
ASYNC_POLLER_DEBUG=false
ASYNC_POLLER_LOG_MAX_CHARS=400

# OSM Geo Layer (Layer 2 Geo-Architecture)
# Overpass API endpoint for osm-geo.* actions.
# Leave empty to use the public instance at overpass-api.de (default).
# For high-volume / SLA workloads run a private Overpass instance and set this
# to its URL (see docker/overpass/README.md for setup instructions).
# OVERPASS_ENDPOINT=http://<host>:12345/api/interpreter

# API Gateway
PORT=3000
# API_URL: Base URL for OpenAPI/Swagger UI server. Use external IP for remote access.
# Examples: http://localhost:3000, http://10.0.0.8:3000, http://your-domain.com
API_URL=http://localhost:3000

# Transporter (leave empty for local development, or use NATS, Redis, MQTT, etc.)
# TRANSPORTER=nats://localhost:4222
TRANSPORTER=

# Cacher (leave empty for no caching, or use Memory, Redis, etc.)
# CACHER=Memory
CACHER=

# Google Gemini AI
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview

# Cernion MCP Token - Get your token from https://cernion.de
CERNION_TOKEN=

# v0.9 Inhouse Data Source Integration
DATASOURCE_MONGO_COLLECTION_REGISTRY=datasource_registry
DATASOURCE_MONGO_COLLECTION_CACHE=datasource_cache
DATASOURCE_MONGO_COLLECTION_AUDIT=datasource_audit
DATASOURCE_CONNECTOR_PLUGINS_DIR=src/connectors
DATASOURCE_CUSTOM_PLUGINS_DIR=custom-connectors
DATASOURCE_MAX_INFER_SAMPLE_ROWS=200
DATASOURCE_SCRAPER_TIMEOUT_MS=30000
DATASOURCE_DEFAULT_PRIVACY_CONTEXT=ai-agent

# VNB Identity (optional — used for automatic EWK/benchmark lookups)
# If set, the agent will use these values without prompting the user.
CERNION_VNB_MASTR_ID=
CERNION_VNB_ID=
CERNION_VNB_NAME=
CERNION_VNB_BDEW=
VNB_ID=
VNB_NAME=
VNB_BDEW=

# Optional LLM-assisted classifier fallback (disabled by default)
CLASSIFIER_LLM_FALLBACK_ENABLED=false

# VNB Monitor — KPI aggregation for Power Automate & Power BI
# Cache TTL in seconds (default: 3600 = 1 hour)
VNB_MONITOR_CACHE_TTL_SECONDS=3600
# Default BDEW codes to monitor (comma-separated, optional)
VNB_MONITOR_DEFAULT_BDEW_CODES=10002954

# Integration Hub (v0.9.6)
TOKEN_STORAGE_FILE=./uploads/.api-tokens.json
# Public URL used in generated Power BI / Power Automate snippets
CERNION_PUBLIC_URL=https://your-cernion-instance.example.com

# NBP Monitor — Netzbetreiberprüfungs-Monitor (v0.9.7)
# Cache TTL for NBP Monitor snapshots in seconds (default: 86400 = 24h)
NBP_CACHE_TTL_SECONDS=86400

# Datapoint Layer (v0.11)
# Path to PouchDB data directory for named, managed datapoints
DATAPOINT_DB_PATH=./.datapoints

# ── EDM (Energiedatenmanagement) ──
EDM_DB_PATH=data/edm
EDM_RETENTION_DAYS=1095
EDM_RETENTION_POLICY=delete

# Datapoint Scheduler (v0.12) — set to 'false' to disable the 60-second refresh tick
DATAPOINT_SCHEDULER_ENABLED=true

# Datapoint Concurrency (v0.13) — max concurrent scheduled refreshes (prevents MCP session overflow)
DATAPOINT_MAX_CONCURRENT_REFRESHES=3

# OEP Connector (v0.12) — Open Energy Platform base URL (override for internal mirror)
OEP_API_BASE_URL=https://openenergyplatform.org/api/v0

# Grid Connection Validation (v0.14) — separate PouchDB for Netzanschluss validation reports
GRID_CONNECTION_DB_PATH=./.grid-connections

# Energy Sharing Validation (v0.15) — separate PouchDB for Energy Sharing validation reports
ENERGY_SHARING_DB_PATH=./.energy-sharing

# Energy Sharing Allocation Engine (v0.16) — separate PouchDB for allocation metadata
ALLOCATION_ENGINE_DB_PATH=./.allocation-engine

# MaStR Data Quality Agent (v0.17) — separate PouchDB for audit reports
MASTR_QUALITY_DB_PATH=./.mastr-quality

# Redispatch Ex-Post Agent (v0.18) — separate PouchDB for settlement audit reports
REDISPATCH_EXPOST_DB_PATH=./.redispatch-expost

# Zielnetzplanung (ZNP) workspace API (v0.21) — PouchDB for project metadata only
ZNP_DB_PATH=./data/znp

# Generic Object Store (v0.20.5) — PouchDB for namespaced document persistence
OBJECT_STORE_DB_PATH=./data/object-store

# Cookbook service (v0.20.5)
# Validation interval in ms (default: 300000 = 5 minutes)
COOKBOOK_VALIDATION_INTERVAL_MS=300000
# Number of related recipes auto-linked per recipe
COOKBOOK_RELATED_LIMIT=3
# Minimum similarity score for related recipe linking
COOKBOOK_RELATED_MIN_SCORE=0.72
# Embedding model for semantic cookbook search
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# ── MaStR Monitoring (Email Notifications + Scalability) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Cernion MaStR Monitor <monitoring@example.de>"
MASTR_MONITOR_BASE_URL=https://api.cernion.de
# Maximum installation records processed per watch run (v0.27.3 default: 50000)
MASTR_MONITOR_MAX_INSTALLATIONS_PER_WATCH=50000
# Enable chunked persistence for large snapshots/deltas (recommended: true)
MASTR_MONITOR_CHUNKING_ENABLED=true
# Chunk size for snapshot/delta detail storage (manifest + chunk docs)
MASTR_MONITOR_CHUNK_SIZE=1000
# Max detailed entries per section in notification emails (summary remains full)
MASTR_MONITOR_EMAIL_DETAIL_LIMIT=100
