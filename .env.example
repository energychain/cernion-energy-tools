# Example Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database (example)
# DATABASE_URL=postgresql://user:password@localhost:5432/cernion

# API Keys (example)
# API_KEY=your-api-key-here

# Energy Market Configuration (example)
# MARKET_API_URL=https://api.example.com
# MARKET_API_KEY=your-market-api-key
