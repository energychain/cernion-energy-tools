# Cernion Energy Tools - Environment Configuration

# Moleculer Configuration
NAMESPACE=cernion
NODE_ID=
LOG_LEVEL=info
REQUEST_TIMEOUT_MS=900000

# Reliability toggles (production hardening)
RETRY_POLICY_ENABLED=false
RETRY_POLICY_RETRIES=5
RETRY_POLICY_DELAY_MS=100
RETRY_POLICY_MAX_DELAY_MS=1000
RETRY_POLICY_FACTOR=2

CIRCUIT_BREAKER_ENABLED=false
CIRCUIT_BREAKER_THRESHOLD=0.5
CIRCUIT_BREAKER_MIN_REQUEST_COUNT=20
CIRCUIT_BREAKER_WINDOW_TIME_SEC=60
CIRCUIT_BREAKER_HALF_OPEN_MS=10000

BULKHEAD_ENABLED=false
BULKHEAD_CONCURRENCY=10
BULKHEAD_MAX_QUEUE_SIZE=100

TRACKING_ENABLED=false
TRACKING_SHUTDOWN_TIMEOUT_MS=5000
METRICS_ENABLED=false
TRACING_ENABLED=false

# Async job poller logging (keep disabled in production unless debugging)
ASYNC_POLLER_DEBUG=false
ASYNC_POLLER_LOG_MAX_CHARS=400

# API Gateway
PORT=3000
# API_URL: Base URL for OpenAPI/Swagger UI server. Use external IP for remote access.
# Examples: http://localhost:3000, http://10.0.0.8:3000, http://your-domain.com
API_URL=http://localhost:3000

# Transporter (leave empty for local development, or use NATS, Redis, MQTT, etc.)
# TRANSPORTER=nats://localhost:4222
TRANSPORTER=

# Cacher (leave empty for no caching, or use Memory, Redis, etc.)
# CACHER=Memory
CACHER=

# Google Gemini AI
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-pro-preview

# Cernion MCP Token - Get your token from https://cernion.de
CERNION_TOKEN=

# v0.9 Inhouse Data Source Integration
DATASOURCE_MONGO_COLLECTION_REGISTRY=datasource_registry
DATASOURCE_MONGO_COLLECTION_CACHE=datasource_cache
DATASOURCE_MONGO_COLLECTION_AUDIT=datasource_audit
DATASOURCE_CONNECTOR_PLUGINS_DIR=src/connectors
DATASOURCE_CUSTOM_PLUGINS_DIR=custom-connectors
DATASOURCE_MAX_INFER_SAMPLE_ROWS=200
DATASOURCE_SCRAPER_TIMEOUT_MS=30000
DATASOURCE_DEFAULT_PRIVACY_CONTEXT=ai-agent

# VNB Identity (optional — used for automatic EWK/benchmark lookups)
# If set, the agent will use these values without prompting the user.
CERNION_VNB_MASTR_ID=
CERNION_VNB_ID=
CERNION_VNB_NAME=
CERNION_VNB_BDEW=
VNB_ID=
VNB_NAME=
VNB_BDEW=

# Optional LLM-assisted classifier fallback (disabled by default)
CLASSIFIER_LLM_FALLBACK_ENABLED=false

# VNB Monitor — KPI aggregation for Power Automate & Power BI
# Cache TTL in seconds (default: 3600 = 1 hour)
VNB_MONITOR_CACHE_TTL_SECONDS=3600
# Default BDEW codes to monitor (comma-separated, optional)
VNB_MONITOR_DEFAULT_BDEW_CODES=10002954
# Path to alert thresholds override file (optional, git-ignored)
VNB_MONITOR_ALERT_CONFIG_FILE=./vnb-monitor-alerts.config.json

# Integration Hub (v0.9.6)
TOKEN_STORAGE_FILE=./uploads/.api-tokens.json
# Public URL used in generated Power BI / Power Automate snippets
CERNION_PUBLIC_URL=https://your-cernion-instance.example.com
